<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar" />
    <!-- File Manager: safed background, kaala text -->
    <style name="FilesTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">#F5F5F5</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">#F5F5F5</item>
        <item name="colorAccent">#E65100</item>
    </style>

    <!-- Video player / image viewer: dark (media ke liye) -->
    <style name="DarkTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#1F1F1F</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="colorPrimary">#1F1F1F</item>
        <item name="colorAccent">#FFB300</item>
    </style>
</resources>
