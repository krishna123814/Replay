<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Lion"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        style="@style/CompactButton"
        android:id="@+id/btnBrowser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="🌐  Normal Browser" />

    <Button
        style="@style/CompactButton"
        android:id="@+id/btnFloating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="🪟  Floating Window" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
        style="@style/CompactButton"
            android:id="@+id/btnFiles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📁  File Manager" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swFiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:checked="true"
            android:text="Float  " />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
        style="@style/CompactButton"
            android:id="@+id/btnMoney"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💵  Money Manager" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swMoney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:checked="true"
            android:text="Float  " />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
        style="@style/CompactButton"
            android:id="@+id/btnIncome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏦  Income Source" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swIncome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:checked="true"
            android:text="Float  " />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
        style="@style/CompactButton"
            android:id="@+id/btnRoutine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏰  Routine / Tasks" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swRoutine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:checked="true"
            android:text="Float  " />
    </LinearLayout>

    <Button
        style="@style/CompactButton"
        android:id="@+id/btnFamily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="🌳  Family Tree" />

    <Button
        style="@style/CompactButton"
        android:id="@+id/btnKrishna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="🦚  Krishna" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
        style="@style/CompactButton"
            android:id="@+id/btnDeploy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📦  Auto Deploy (server.zip) ⚙" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swDeploy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:text="On  " />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDeployStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
        style="@style/CompactButton"
            android:id="@+id/btnGit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🐙  Auto Deploy (GitHub) ⚙" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swGit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:text="On  " />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGitStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textSize="11sp" />

    <Button
        style="@style/CompactButton"
        android:id="@+id/btnTheft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="🛡️  Anti-theft (galat password = photo)" />

    <Button
        style="@style/CompactButton"
        android:id="@+id/btnStopFloating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✕  Floating band karo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Floating ke liye &quot;Display over other apps&quot; permission chahiye"
        android:textSize="12sp" />
</LinearLayout>
</ScrollView>
